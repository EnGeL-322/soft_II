# Copia este archivo a ".env" (junto a docker-compose.yml) si quieres cambiar los valores por
# defecto. docker compose lo carga automáticamente si se llama ".env".

DB_NAME=huata
DB_USER=huata
DB_PASSWORD=huata

# Cambiar en cualquier entorno real: es solo un valor de desarrollo.
HUATA_JWT_SECRET=huata-lacteos-clave-secreta-desarrollo-cambiar-en-produccion-1234567890

# Sembrar datos DEMO al levantar el contenedor (roles, usuarios, productores, recojos de ejemplo).
HUATA_SEED_DEMO=true

WEB_PORT=8081
BACKEND_PORT=8080
