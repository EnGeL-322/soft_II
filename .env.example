# Copia este archivo como .env y ajusta los valores:  cp .env.example .env
#
# El .env NO se versiona (esta en .gitignore). Este .env.example si, y por eso solo contiene
# valores de ejemplo para desarrollo local: ningun secreto real vive en el repositorio.

# --- Base de datos ---
DB_NAME=huata
DB_USER=huata
# En una maquina de desarrollo dejalo en "huata": es el valor por defecto que asume el perfil
# dev, y asi el backend arrancado desde el IDE encuentra la misma base que levanta el compose.
# En cualquier entorno que no sea tu laptop, ponle una clave real.
DB_PASSWORD=huata
# Puerto por el que se expone PostgreSQL en tu maquina (cambialo si ya tienes uno en el 5432).
DB_PORT_HOST=5432

# --- Backend ---
# Clave de firma de los JWT. Debe tener 32 caracteres o mas (HMAC-SHA256).
# Genera una propia:  openssl rand -base64 48
HUATA_JWT_SECRET=cambia-esta-clave-por-una-generada-de-al-menos-32-caracteres
HUATA_JWT_EXPIRATION_MIN=480
# Origenes permitidos (REST y WebSocket). Incluye el tunel Cloudflare de pruebas del APK movil;
# si el tunel cambia, reemplaza la URL. `flutter build apk` usa el mismo valor en
# huata_app/lib/core/api/api_config.dart (o compilalo con --dart-define=HUATA_API_BASE_URL=...).
HUATA_CORS_ORIGINS=http://localhost:8081,http://localhost:8082,https://anyone-ash-bias-drop.trycloudflare.com

# --- Ingesta automatica (equipo de domotica) ---
# Clave con la que el equipo firma sus envios a POST /api/v1/ingesta/recepciones, en la cabecera
# X-Api-Key. Si se deja vacia, esa ruta responde 401: sin clave configurada no entra nadie.
# Genera una propia:  openssl rand -base64 32
HUATA_INGESTA_API_KEY=

# --- IVR telefonico (ivr/README.md) ---
# Clave con la que el servicio huata-ivr del mini PC de la planta llama a /api/v1/ivr/**, en la
# cabecera X-Api-Key. Distinta de la de ingesta. Vacia = esa ruta responde 401 a todos.
# Genera una propia:  openssl rand -base64 32
HUATA_IVR_API_KEY=

# Equipo de medicion (ESP32) al que llama el boton "Llamar datos" del formulario de recepcion.
# Lo consulta el SERVIDOR, no el navegador, asi que basta con que el equipo sea alcanzable desde
# donde corre el backend. Vacio = el boton queda deshabilitado y la captura es manual.
# Ej: HUATA_INSTRUMENTO_URL=http://192.168.1.50/lectura
HUATA_INSTRUMENTO_URL=

# App movil (APK directo, ver docs/APP_MOVIL_ACTUALIZACIONES.md). Los parches de codigo llegan por
# Shorebird sin tocar esto; esto es solo para una version nueva del APK.
#   VERSION_ACTUAL  -> la del APK copiado en ./descargas (la app ofrece actualizar si tiene una menor)
#   VERSION_MINIMA  -> por debajo de esta la app no deja trabajar hasta actualizar (vacio = ninguna)
#   URL_DESCARGA    -> direccion publica del APK, p. ej. https://tu-dominio/descargas/huata.apk
HUATA_APP_VERSION_ACTUAL=
HUATA_APP_VERSION_MINIMA=
HUATA_APP_URL_DESCARGA=
HUATA_APP_NOTAS=

# Siembra los datos DEMO (proveedores, recepciones, calidad, liquidaciones... de 14 dias) para que
# el sistema arranque con contenido y se pueda entrar.
#
#   true  -> util para probar y demostrar. Crea usuarios con una contrasena conocida del repo.
#   false -> OBLIGATORIO en cualquier entorno con datos reales.
#
# Mientras no exista un comando de creacion del primer administrador (pendiente de la Fase 2), con
# false la base arranca vacia y no habria con que iniciar sesion.
HUATA_SEED_DEMO=true

# Demostracion del acopio: al dar de alta un proveedor se le asigna una vivienda en un punto al
# azar DENTRO del poligono de su zona, para ver el recorrido en la web y en la app sin salir a
# campo. La bitacora la marca como SIMULADA.
#   true  -> solo para demostrar.
#   false -> OBLIGATORIO con datos reales (la ubicacion la toma el proveedor o la planta).
HUATA_SIMULAR_UBICACIONES=false

# --- Frontend ---
WEB_PORT=8081

# --- App movil (build web de Flutter, huata_app/) ---
MOVIL_PORT=8082

# --- Solo Windows con inspeccion TLS corporativa ---
# Descomenta si el build de Maven falla por certificados:
# MAVEN_OPTS=-Djavax.net.ssl.trustStoreType=WINDOWS-ROOT

# --- Correo saliente (codigo de verificacion de Configuracion) ---
# Sin SPRING_MAIL_HOST el backend NO envia correo: escribe el codigo en el log y el cambio de precios
# sigue funcionando. Util en desarrollo; en produccion hay que configurarlo.
#
# Para Gmail: SPRING_MAIL_HOST=smtp.gmail.com, SPRING_MAIL_PORT=587 y una CONTRASENA DE APLICACION
# (Google > Cuenta > Seguridad > Contrasenas de aplicacion), nunca la contrasena del correo.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=no-reply@huata.coop

# Minutos que vive el codigo de 6 digitos antes de vencer.
HUATA_VERIFICACION_MIN=10

# ---- Almacen de fotos de voucher (servicio "almacen" de docker-compose, compatible con S3) ----
# Credenciales propias de este almacen; cambialas. La clave secreta debe tener 8 caracteres o mas.
HUATA_ALMACEN_ACCESS_KEY=huata-almacen
HUATA_ALMACEN_SECRET_KEY=cambia-esta-clave-secreta
HUATA_ALMACEN_BUCKET=huata-evidencias
